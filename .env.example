# Phase 1 defaults to the local MockProvider.
COMMERCE_PROVIDER=mock

# Public client-side Supabase values. Safe to ship; RLS must protect data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_EAS_PROJECT_ID=

# Server-side secrets belong in Supabase Edge Function secrets only:
# TOAST_CLIENT_ID
# TOAST_CLIENT_SECRET
# TOAST_API_HOSTNAME
# ADMIN_PASSWORD_HASH
